# --- Next.js / Clerk / Convex (put in .env.local) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- n8n (docker compose reads these from .env) ---
N8N_ENCRYPTION_KEY=
N8N_PUBLIC_URL= 
LENDLOOP_WEBHOOK_SECRET=
# --- Convex dashboard env vars (npx convex env set NAME value) ---
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# WEBHOOK_SECRET=<same as LENDLOOP_WEBHOOK_SECRET>
# N8N_WEBHOOK_URL=https://your-tunnel.ngrok.app/webhook/lendloop-request-event
# ADMIN_EMAILS=you@example.com

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
